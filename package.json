{
  "name": "digital-clock",
  "version": "1.0.4",
  "description": "Animated desktop digital clock with rich customization - Electron app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable",
    "dist": "electron-builder --win portable"
  },
  "author": "Yejack819",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/Yejack819/AniClock-Desktop.git"
  },
  "build": {
    "appId": "com.clock.digital",
    "productName": "Digital Clock",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!backup{,/**}",
      "!releases{,/**}",
      "!docs{,/**}",
      "!.workbuddy{,/**}",
      "!dist{,/**}",
      "!node_modules{,/**}",
      "!.git{,/**}",
      "!.gitignore",
      "!*.md",
      "!release.json",
      "!alarms.json"
    ],
    "win": {
      "target": ["dir"]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
